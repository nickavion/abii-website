# Kit (formerly ConvertKit) form id for the §9b waitlist.
#
# Where to find it: Kit → Grow → Landing Pages & Forms → your form → Embed →
# HTML. The embed code posts to https://app.kit.com/forms/<ID>/subscriptions —
# <ID> is the value below.
#
# Until this is set the waitlist form renders disabled, so no signup is
# silently dropped.
PUBLIC_KIT_FORM_ID=
